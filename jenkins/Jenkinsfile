@Library('iclabs_sample') _

pipeline {
  agent {
    label 'k8s-agent'
  }

  options {
    // timestamps()
    disableConcurrentBuilds()
    timeout(time: 10, unit: 'MINUTES')
  }

  environment {
    PYTHON_VENV = ".venv"
    ARTIFACT_NAME = "echo_server.tar.gz"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Bootstrap Python') {
      steps {
        pythonBootstrap(
          requirements: 'tools/python_helper/requirements.txt'
        )
      }
    }

    stage('Build') {
      steps {
        // sh './scripts/build.sh'
        // Uses cppBuild from https://github.com/ic-devops-lab/jenkins-shared-lib-sample
        cppBuild(
          // buildDir: 'build',
          // buildType: 'Debug',
          // buildTesting: true
        )
      }
    }

    stage('Unit Tests') {
      steps {
        sh 'ctest --test-dir build --output-on-failure'
      }
    }

    stage('Integration Tests') {
      steps {
        sh '''
          . .venv/bin/activate
          pytest app/tests/integration -q
        '''
      }
    }

    stage('Code Quality') {
      steps {
        sh '''
          set -e

          echo "=== Running cppcheck ==="
          cppcheck --enable=all --inconclusive --quiet app/src app/include 2> cppcheck-report.txt || true

          echo "=== Running clang-format check ==="
          find app/src app/include -type f \\( -name "*.cpp" -o -name "*.hpp" \\) -print0 | \
            xargs -0 clang-format --dry-run --Werror
        '''
      }
    }

    // stage('SonarQube Analysis') {
    //   environment {
    //     SONAR_SCANNER_HOME = tool name: 'sonar-scanner'
    //   }
    //   steps {
    //     withSonarQubeEnv('sonarqube') {
    //       sh '''
    //         test -f build/compile_commands.json
    //         ${SONAR_SCANNER_HOME}/bin/sonar-scanner
    //       '''
    //     }
    //   }
    // }

    // stage('Quality Gate') {
    //   steps {
    //     timeout(time: 10, unit: 'MINUTES') {
    //       waitForQualityGate abortPipeline: true
    //     }
    //   }
    // }

    stage('Package Artifact') {
      steps {
        sh 'chmod +x scripts/package.sh'
        sh './scripts/package.sh'
      }
    }

    stage('Archive Artifact') {
      steps {
        archiveArtifacts artifacts: 'build/*.tar.gz', fingerprint: true
        archiveArtifacts artifacts: 'cppcheck-report.txt', fingerprint: true, onlyIfSuccessful: false
      }
    }
  }

  post {
    always {
      deleteDir()
    }
    success {
      echo 'Pipeline completed successfully.'
    }
    failure {
      echo 'Pipeline failed. Check stage logs above.'
    }
  }
}